# Meridian environment switches (copy to .env.local and adjust).
# See docs/Meridian_TRD_v1.0.pdf section 11.2.

# Data source for the frontend:
#   local = browser-local store + Next.js route proxies (no backend needed)
#   rest  = Spring Boot backend (NEXT_PUBLIC_API_BASE_URL required)
NEXT_PUBLIC_API_MODE=local

# Base URL of the Spring Boot API, used only in rest mode.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Backend-only secrets (never exposed to the browser):
# DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=change-me
# LLM_API_KEY=change-me
